# =====================================================================
#  steel-intel  -  notification credentials
#  Primary channel = LINE Messaging API (LINE Official Account)
# =====================================================================

# --- LINE (PRIMARY - required for real alerts) ---
# How to get these (see README.md for full steps):
#   1. developers.line.biz/console -> create Provider
#   2. Create channel -> Messaging API (auto-creates a LINE Official Account)
#   3. tab "Messaging API" -> Channel access token (long-lived) -> Issue
#   4. tab "Basic settings" -> bottom -> "Your user ID" (uXXXX...)
#   5. ADD the OA as a friend (scan its QR) or push won't be delivered
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- NOTE: there is no second channel any more ---
# A Telegram fallback (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID) was removed on
# 2026-09-05: it was never configured in .env or in the GitHub secrets, so it
# had never run once. Without LINE credentials the app is in DRY-RUN and prints
# messages to the console instead of sending them.

# --- Optional: AI deep summary (rule-based scoring works without this) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Cloud deploy ONLY (leave empty for local SQLite) ---
# When set to a Postgres URL the app stores state in that DB instead of news.db.
# Required for the GitHub Actions deployment (the runner disk is wiped each run).
# Supabase: Project -> Connect -> "Session pooler" connection string (IPv4-safe).
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
